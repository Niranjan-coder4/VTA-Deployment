{
  "version": 2,
  "name": "vta-frontend",
  "builds": [
    {
      "src": "Code/frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://vta-flask-backend.fly.dev/api/$1"
    },
    {
      "src": "/drive/(.*)",
      "dest": "https://vta-flask-backend.fly.dev/drive/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://vta-flask-backend.fly.dev/uploads/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/Code/frontend/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/Code/frontend/$1"
    }
  ]
}